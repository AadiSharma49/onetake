# Copy to worker/.env and fill in real values for local dev.

# Direct (unpooled) Postgres connection — same value as the Next.js app's
# DATABASE_URL_UNPOOLED. The worker writes with raw SQL, not Prisma.
DATABASE_URL_UNPOOLED=

# Neon Object Storage — same bucket/credentials the Next.js app already uses.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Groq Whisper API — console.groq.com
GROQ_API_KEY=

# Upstash Redis — the standard rediss:// connection string (not the REST
# URL/token the Next.js side uses for its own push — this worker uses the
# plain redis-py client, which needs the real Redis protocol).
REDIS_URL=
